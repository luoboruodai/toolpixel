#include <winver.h>
16000 "PiPL" DISCARDABLE "ToonPixel.pipl"

1 VERSIONINFO
 FILEVERSION 0,1,2,1
 PRODUCTVERSION 0,1,2,1
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "ToonPixel"
   VALUE "FileDescription", "ToonPixel SmartFX After Effects Plug-in"
   VALUE "FileVersion", "0.1.2"
   VALUE "InternalName", "ToonPixel"
   VALUE "OriginalFilename", "ToonPixel.aex"
   VALUE "ProductName", "ToonPixel SmartFX"
   VALUE "ProductVersion", "0.1.2"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
